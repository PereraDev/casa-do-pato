# Copie para .env e preencha (.env nunca é commitado — ver .gitignore).

# Connection string do Postgres (ex.: projeto gratuito no https://neon.tech).
DATABASE_URL="postgresql://usuario:senha@ep-xxx.neon.tech/nomedobanco?sslmode=require"

# Chave de 32 bytes em hex pro @fastify/secure-session (gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET="troque-por-uma-chave-de-32-bytes-em-hex"

PORT=4000

# Opcional — chave da API do Gemini (grátis, gere em
# https://aistudio.google.com/apikey), só usada pela busca por IA do
# cardápio (POST /api/ia/busca). Sem ela, essa rota responde 503 e a busca
# do cliente cai de volta pra filtro por texto comum (ver
# src/components/header/SearchBar.jsx).
GEMINI_API_KEY=""

# Opcional — envio de e-mail (código de confirmação no cadastro e de recuperação de
# senha) pela API do Resend (https://resend.com). Sem RESEND_API_KEY o envio fica
# desligado: o cadastro entra direto, sem confirmar o e-mail, e o código de
# recuperação sai só no log do servidor (modo desenvolvimento).
# EMAIL_FROM precisa ser de um domínio verificado no Resend pra chegar em clientes;
# o remetente padrão (onboarding@resend.dev) só entrega no e-mail dono da conta Resend.
RESEND_API_KEY=""
EMAIL_FROM="Casa do Pato <nao-responda@seudominio.com.br>"
